<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Farmer Direct Inventory{% endblock %}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root {
      --sidebar-width: 240px;
      --brand: #1a5f2a;
      --brand-light: #e8f5e9;
    }
    body { background: #f4f6f9; min-height: 100vh; }
    .sidebar {
      width: var(--sidebar-width);
      background: #1e2a24;
      min-height: 100vh;
      position: fixed;
      top: 0; left: 0;
      z-index: 100;
      padding-top: 1rem;
    }
    .sidebar .nav-link {
      color: #c8d6c9;
      border-radius: 0.375rem;
      margin: 0.15rem 0.75rem;
      padding: 0.55rem 0.9rem;
    }
    .sidebar .nav-link:hover, .sidebar .nav-link.active {
      background: var(--brand);
      color: #fff;
    }
    .sidebar .brand {
      color: #fff;
      font-weight: 700;
      font-size: 1.1rem;
      padding: 0.5rem 1.25rem 1.25rem;
      border-bottom: 1px solid #2d3d34;
      margin-bottom: 0.75rem;
    }
    .main {
      margin-left: var(--sidebar-width);
      padding: 1.5rem 1.75rem;
    }
    .stat-card {
      border: none;
      border-radius: 0.75rem;
      box-shadow: 0 1px 3px rgba(0,0,0,.08);
    }
    .stat-card .stat-value { font-size: 1.75rem; font-weight: 700; }
    .table-card {
      background: #fff;
      border-radius: 0.75rem;
      box-shadow: 0 1px 3px rgba(0,0,0,.08);
      overflow: hidden;
    }
    .badge-low { background: #ffc107; color: #000; }
    .badge-out { background: #dc3545; }
    .badge-ok { background: #198754; }
    @media (max-width: 768px) {
      .sidebar { width: 100%; min-height: auto; position: relative; }
      .main { margin-left: 0; }
    }
  </style>
  {% block extra_css %}{% endblock %}
</head>
<body>
  {% if current_user.is_authenticated %}
  <div class="d-flex">
    <nav class="sidebar">
      <div class="brand">
        <i class="bi bi-box-seam"></i> Farmer Direct
      </div>
      <ul class="nav flex-column">
        <li class="nav-item"><a class="nav-link {% if request.endpoint == 'dashboard' %}active{% endif %}" href="{{ url_for('dashboard') }}"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
        <li class="nav-item"><a class="nav-link {% if request.endpoint == 'inventory' %}active{% endif %}" href="{{ url_for('inventory') }}"><i class="bi bi-boxes me-2"></i>Inventory</a></li>
        <li class="nav-item"><a class="nav-link {% if request.endpoint and 'product' in request.endpoint %}active{% endif %}" href="{{ url_for('products') }}"><i class="bi bi-tags me-2"></i>Products</a></li>
        <li class="nav-item"><a class="nav-link {% if request.endpoint and 'receiving' in request.endpoint %}active{% endif %}" href="{{ url_for('receiving_list') }}"><i class="bi bi-box-arrow-in-down me-2"></i>Receiving</a></li>
        <li class="nav-item"><a class="nav-link {% if request.endpoint and 'transfer' in request.endpoint %}active{% endif %}" href="{{ url_for('transfers_list') }}"><i class="bi bi-arrow-left-right me-2"></i>Sales / Transfers</a></li>
        <li class="nav-item"><a class="nav-link {% if request.endpoint and 'waste' in request.endpoint %}active{% endif %}" href="{{ url_for('waste_list') }}"><i class="bi bi-trash me-2"></i>Waste / Adjust</a></li>
        <li class="nav-item"><a class="nav-link {% if request.endpoint == 'locations' %}active{% endif %}" href="{{ url_for('locations') }}"><i class="bi bi-geo-alt me-2"></i>Locations</a></li>
        {% if current_user.role == 'admin' %}
        <li class="nav-item"><a class="nav-link {% if request.endpoint == 'users_page' %}active{% endif %}" href="{{ url_for('users_page') }}"><i class="bi bi-people me-2"></i>Users</a></li>
        {% endif %}
        <li class="nav-item mt-3"><a class="nav-link" href="{{ url_for('logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
      </ul>
      <div class="px-3 mt-4 text-muted small">
        {{ current_user.full_name or current_user.username }}
        <br><span class="badge bg-secondary">{{ current_user.role }}</span>
      </div>
    </nav>
    <main class="main flex-grow-1">
      {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
          {% for category, message in messages %}
            <div class="alert alert-{{ category }} alert-dismissible fade show" role="alert">
              {{ message }}
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          {% endfor %}
        {% endif %}
      {% endwith %}
      {% block content %}{% endblock %}
    </main>
  </div>
  {% else %}
    {% block auth_content %}{% endblock %}
  {% endif %}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  {% block extra_js %}{% endblock %}
</body>
</html>

{% extends "base.html" %}
{% block title %}Dashboard – Farmer Direct{% endblock %}
{% block content %}
<h2 class="mb-4">Inventory Control Center</h2>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card stat-card">
      <div class="card-body">
        <div class="text-muted small">Total Inventory Value</div>
        <div class="stat-value text-success">${{ "%.2f"|format(total_value) }}</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card">
      <div class="card-body">
        <div class="text-muted small">Units On Hand</div>
        <div class="stat-value">{{ "%.1f"|format(total_units) }}</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card">
      <div class="card-body">
        <div class="text-muted small">Low Stock Items</div>
        <div class="stat-value text-warning">{{ low_stock }}</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card">
      <div class="card-body">
        <div class="text-muted small">Out of Stock</div>
        <div class="stat-value text-danger">{{ out_of_stock }}</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="table-card">
      <div class="p-3 border-bottom fw-semibold">Stock by Category</div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead><tr><th>Category</th><th class="text-end">Units</th><th class="text-end">Value</th></tr></thead>
          <tbody>
            {% for row in by_category %}
            <tr>
              <td>{{ row.category }}</td>
              <td class="text-end">{{ "%.1f"|format(row.units) }}</td>
              <td class="text-end">${{ "%.2f"|format(row.value) }}</td>
            </tr>
            {% else %}
            <tr><td colspan="3" class="text-muted text-center py-3">No inventory yet</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="table-card">
      <div class="p-3 border-bottom fw-semibold d-flex justify-content-between">
        <span>Needs Attention</span>
        <a href="{{ url_for('inventory') }}" class="small">View all</a>
      </div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead><tr><th>Product</th><th>Location</th><th class="text-end">Qty</th><th>Status</th></tr></thead>
          <tbody>
            {% for item in low_items %}
            <tr>
              <td>{{ item.name }} <small class="text-muted">{{ item.sku }}</small></td>
              <td>{{ item.location_name }}</td>
              <td class="text-end">{{ item.qty_on_hand }}</td>
              <td>
                {% if item.status == 'OUT OF STOCK' %}
                  <span class="badge badge-out">OUT</span>
                {% else %}
                  <span class="badge badge-low">LOW</span>
                {% endif %}
              </td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="text-muted text-center py-3">All good — no low stock</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="table-card mt-4">
  <div class="p-3 border-bottom fw-semibold d-flex justify-content-between">
    <span>Recent Receiving</span>
    <a href="{{ url_for('receiving_add') }}" class="btn btn-sm btn-success">+ New Receipt</a>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>Date</th><th>Product</th><th>Batch</th><th>Location</th>
          <th class="text-end">Qty</th><th class="text-end">Cost</th><th>By</th>
        </tr>
      </thead>
      <tbody>
        {% for r in recent_receiving %}
        <tr>
          <td>{{ r.date }}</td>
          <td>{{ r.product_name or '—' }} <small class="text-muted">{{ r.sku }}</small></td>
          <td>{{ r.batch_lot or '—' }}</td>
          <td>{{ r.location_name or '—' }}</td>
          <td class="text-end">{{ r.qty_received }}</td>
          <td class="text-end">${{ "%.2f"|format(r.total_cost or 0) }}</td>
          <td>{{ r.received_by or '—' }}</td>
        </tr>
        {% else %}
        <tr><td colspan="7" class="text-muted text-center py-3">No receiving records yet</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}

{% extends "base.html" %}
{% block title %}Current Inventory – Farmer Direct{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Current Inventory</h2>
  <div>
    <a href="{{ url_for('receiving_add') }}" class="btn btn-success btn-sm"><i class="bi bi-plus-lg"></i> Receive</a>
    <a href="{{ url_for('transfers_add') }}" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-left-right"></i> Sale / Transfer</a>
  </div>
</div>

<div class="table-card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>SKU</th><th>Product</th><th>Category</th><th>Batch / Lot</th>
          <th>Location</th><th class="text-end">Qty</th><th class="text-end">Unit Cost</th>
          <th class="text-end">Value</th><th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% for i in items %}
        <tr>
          <td><code>{{ i.sku }}</code></td>
          <td>{{ i.name }}</td>
          <td>{{ i.category }}</td>
          <td>{{ i.batch_lot or '—' }}</td>
          <td>{{ i.location_name }}</td>
          <td class="text-end">{{ i.qty_on_hand }} {{ i.unit }}</td>
          <td class="text-end">${{ "%.2f"|format(i.unit_cost or 0) }}</td>
          <td class="text-end">${{ "%.2f"|format((i.qty_on_hand or 0) * (i.unit_cost or 0)) }}</td>
          <td>
            {% if i.status == 'OUT OF STOCK' or i.qty_on_hand <= 0 %}
              <span class="badge badge-out">OUT OF STOCK</span>
            {% elif i.status == 'LOW STOCK' %}
              <span class="badge badge-low">LOW STOCK</span>
            {% else %}
              <span class="badge badge-ok">IN STOCK</span>
            {% endif %}
          </td>
        </tr>
        {% else %}
        <tr><td colspan="9" class="text-center text-muted py-4">No inventory records. Start by receiving stock.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}

{% extends "base.html" %}
{% block title %}Locations – Farmer Direct{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Storage Locations</h2>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <div class="table-card">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr><th>Name</th><th>Area</th><th>Type</th><th>Active</th></tr>
          </thead>
          <tbody>
            {% for l in locations %}
            <tr>
              <td>{{ l.name }}</td>
              <td>{{ l.area or '—' }}</td>
              <td>{{ l.storage_type or '—' }}</td>
              <td>{% if l.active %}<span class="badge bg-success">Yes</span>{% else %}<span class="badge bg-secondary">No</span>{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h5 class="card-title">Add Location</h5>
        <form method="post" action="{{ url_for('location_add') }}">
          <div class="mb-3">
            <label class="form-label">Name *</label>
            <input type="text" name="name" class="form-control" required placeholder="e.g. Vault C">
          </div>
          <div class="mb-3">
            <label class="form-label">Area / Room</label>
            <input type="text" name="area" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Storage Type</label>
            <input type="text" name="storage_type" class="form-control" placeholder="Secured Storage, Production…">
          </div>
          <button type="submit" class="btn btn-success">Add Location</button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% extends "base.html" %}
{% block title %}Login – Farmer Direct Inventory{% endblock %}
{% block auth_content %}
<div class="container">
  <div class="row justify-content-center align-items-center min-vh-100">
    <div class="col-md-5 col-lg-4">
      <div class="card shadow border-0">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <i class="bi bi-box-seam display-4 text-success"></i>
            <h3 class="mt-2 mb-0">Farmer Direct</h3>
            <p class="text-muted">Inventory Control Center</p>
          </div>
          {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
              {% for category, message in messages %}
                <div class="alert alert-{{ category }} py-2">{{ message }}</div>
              {% endfor %}
            {% endif %}
          {% endwith %}
          <form method="post">
            <div class="mb-3">
              <label class="form-label">Username</label>
              <input type="text" name="username" class="form-control" required autofocus>
            </div>
            <div class="mb-3">
              <label class="form-label">Password</label>
              <input type="password" name="password" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-success w-100">Sign In</button>
          </form>
          <hr>
          <p class="small text-muted mb-0">
            Default accounts:<br>
            admin / admin123<br>
            warehouse / warehouse1<br>
            retail / retail1
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% extends "base.html" %}
{% block title %}{{ 'Edit' if product else 'Add' }} Product – Farmer Direct{% endblock %}
{% block content %}
<h2 class="mb-4">{{ 'Edit' if product else 'Add' }} Product</h2>
<div class="card border-0 shadow-sm" style="max-width:720px">
  <div class="card-body">
    <form method="post">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">SKU *</label>
          <input type="text" name="sku" class="form-control" required value="{{ product.sku if product else '' }}">
        </div>
        <div class="col-md-8">
          <label class="form-label">Product Name *</label>
          <input type="text" name="name" class="form-control" required value="{{ product.name if product else '' }}">
        </div>
        <div class="col-md-4">
          <label class="form-label">Category *</label>
          <select name="category" class="form-select" required>
            {% for c in categories %}
            <option value="{{ c }}" {% if product and product.category == c %}selected{% endif %}>{{ c }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Product Type</label>
          <input type="text" name="product_type" class="form-control" value="{{ product.product_type if product else '' }}" placeholder="e.g. Indoor, Live Resin">
        </div>
        <div class="col-md-2">
          <label class="form-label">Unit Size</label>
          <input type="number" step="any" name="unit_size" class="form-control" value="{{ product.unit_size if product else '' }}">
        </div>
        <div class="col-md-2">
          <label class="form-label">Unit</label>
          <input type="text" name="unit" class="form-control" value="{{ product.unit if product else 'g' }}">
        </div>
        <div class="col-md-4">
          <label class="form-label">Supplier</label>
          <input type="text" name="supplier" class="form-control" value="{{ product.supplier if product else '' }}">
        </div>
        <div class="col-md-2">
          <label class="form-label">Reorder Level</label>
          <input type="number" step="any" name="reorder_level" class="form-control" value="{{ product.reorder_level if product else 0 }}">
        </div>
        <div class="col-md-3">
          <label class="form-label">Unit Cost ($)</label>
          <input type="number" step="0.01" name="unit_cost" class="form-control" value="{{ product.unit_cost if product else 0 }}">
        </div>
        <div class="col-md-3">
          <label class="form-label">Retail Price ($)</label>
          <input type="number" step="0.01" name="retail_price" class="form-control" value="{{ product.retail_price if product else 0 }}">
        </div>
        <div class="col-12">
          <label class="form-label">Notes</label>
          <textarea name="notes" class="form-control" rows="2">{{ product.notes if product else '' }}</textarea>
        </div>
        <div class="col-12">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="active" id="active" {% if not product or product.active %}checked{% endif %}>
            <label class="form-check-label" for="active">Active</label>
          </div>
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-success">Save Product</button>
        <a href="{{ url_for('products') }}" class="btn btn-outline-secondary ms-2">Cancel</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}

{% extends "base.html" %}
{% block title %}Products – Farmer Direct{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Product Catalog</h2>
  <a href="{{ url_for('product_add') }}" class="btn btn-success"><i class="bi bi-plus-lg"></i> Add Product</a>
</div>

<div class="table-card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>SKU</th><th>Name</th><th>Category</th><th>Type</th>
          <th class="text-end">Unit Size</th><th class="text-end">Reorder</th>
          <th class="text-end">Cost</th><th class="text-end">Retail</th><th>Active</th><th></th>
        </tr>
      </thead>
      <tbody>
        {% for p in products %}
        <tr>
          <td><code>{{ p.sku }}</code></td>
          <td>{{ p.name }}</td>
          <td>{{ p.category }}</td>
          <td>{{ p.product_type or '—' }}</td>
          <td class="text-end">{{ p.unit_size }} {{ p.unit }}</td>
          <td class="text-end">{{ p.reorder_level }}</td>
          <td class="text-end">${{ "%.2f"|format(p.unit_cost or 0) }}</td>
          <td class="text-end">${{ "%.2f"|format(p.retail_price or 0) }}</td>
          <td>{% if p.active %}<span class="badge bg-success">Yes</span>{% else %}<span class="badge bg-secondary">No</span>{% endif %}</td>
          <td><a href="{{ url_for('product_edit', pid=p.id) }}" class="btn btn-sm btn-outline-secondary">Edit</a></td>
        </tr>
        {% else %}
        <tr><td colspan="10" class="text-center text-muted py-4">No products yet</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}

{% extends "base.html" %}
{% block title %}New Receipt – Farmer Direct{% endblock %}
{% block content %}
<h2 class="mb-4">Record Receiving</h2>
<div class="card border-0 shadow-sm" style="max-width:720px">
  <div class="card-body">
    <form method="post">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Date *</label>
          <input type="date" name="date" class="form-control" required value="{{ today }}">
        </div>
        <div class="col-md-4">
          <label class="form-label">Receipt ID</label>
          <input type="text" name="receipt_id" class="form-control" placeholder="Auto if blank">
        </div>
        <div class="col-md-4">
          <label class="form-label">Supplier</label>
          <input type="text" name="supplier" class="form-control">
        </div>
        <div class="col-md-8">
          <label class="form-label">Product *</label>
          <select name="product_id" class="form-select" required>
            <option value="">Select product…</option>
            {% for p in products %}
            <option value="{{ p.id }}" data-cost="{{ p.unit_cost }}">{{ p.sku }} — {{ p.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Batch / Lot #</label>
          <input type="text" name="batch_lot" class="form-control" placeholder="e.g. BATCH-001">
        </div>
        <div class="col-md-4">
          <label class="form-label">Location *</label>
          <select name="location_id" class="form-select" required>
            {% for l in locations %}
            <option value="{{ l.id }}">{{ l.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Qty Received *</label>
          <input type="number" step="any" name="qty_received" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Unit Cost ($)</label>
          <input type="number" step="0.01" name="unit_cost" id="unit_cost" class="form-control" value="0">
        </div>
        <div class="col-md-6">
          <label class="form-label">Reference #</label>
          <input type="text" name="reference_number" class="form-control">
        </div>
        <div class="col-12">
          <label class="form-label">Notes</label>
          <textarea name="notes" class="form-control" rows="2"></textarea>
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-success">Save & Update Stock</button>
        <a href="{{ url_for('receiving_list') }}" class="btn btn-outline-secondary ms-2">Cancel</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}
{% block extra_js %}
<script>
document.querySelector('select[name="product_id"]').addEventListener('change', function() {
  const opt = this.options[this.selectedIndex];
  const cost = opt.getAttribute('data-cost') || 0;
  document.getElementById('unit_cost').value = cost;
});
</script>
{% endblock %}

{% extends "base.html" %}
{% block title %}Receiving – Farmer Direct{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Receiving / Purchases</h2>
  <a href="{{ url_for('receiving_add') }}" class="btn btn-success"><i class="bi bi-plus-lg"></i> New Receipt</a>
</div>

<div class="table-card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>Receipt ID</th><th>Date</th><th>Supplier</th><th>Product</th>
          <th>Batch</th><th>Location</th><th class="text-end">Qty</th>
          <th class="text-end">Unit Cost</th><th class="text-end">Total</th><th>By</th>
        </tr>
      </thead>
      <tbody>
        {% for r in records %}
        <tr>
          <td><code>{{ r.receipt_id }}</code></td>
          <td>{{ r.date }}</td>
          <td>{{ r.supplier or '—' }}</td>
          <td>{{ r.product_name or '—' }} <small class="text-muted">{{ r.sku }}</small></td>
          <td>{{ r.batch_lot or '—' }}</td>
          <td>{{ r.location_name or '—' }}</td>
          <td class="text-end">{{ r.qty_received }}</td>
          <td class="text-end">${{ "%.2f"|format(r.unit_cost or 0) }}</td>
          <td class="text-end">${{ "%.2f"|format(r.total_cost or 0) }}</td>
          <td>{{ r.received_by or '—' }}</td>
        </tr>
        {% else %}
        <tr><td colspan="10" class="text-center text-muted py-4">No receiving records yet</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}

{% extends "base.html" %}
{% block title %}New Sale / Transfer – Farmer Direct{% endblock %}
{% block content %}
<h2 class="mb-4">Record Sale or Transfer</h2>
<div class="card border-0 shadow-sm" style="max-width:720px">
  <div class="card-body">
    <form method="post">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Date *</label>
          <input type="date" name="date" class="form-control" required value="{{ today }}">
        </div>
        <div class="col-md-4">
          <label class="form-label">Type *</label>
          <select name="type" class="form-select" required>
            <option value="Sale">Sale</option>
            <option value="Transfer">Transfer</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Transaction ID</label>
          <input type="text" name="transaction_id" class="form-control" placeholder="Auto if blank">
        </div>
        <div class="col-md-6">
          <label class="form-label">Product *</label>
          <select name="product_id" class="form-select" required>
            <option value="">Select product…</option>
            {% for p in products %}
            <option value="{{ p.id }}">{{ p.sku }} — {{ p.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Batch / Lot #</label>
          <input type="text" name="batch_lot" class="form-control" placeholder="Must match existing batch">
        </div>
        <div class="col-md-6">
          <label class="form-label">From Location *</label>
          <select name="from_location_id" class="form-select" required>
            {% for l in locations %}
            <option value="{{ l.id }}">{{ l.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">To Location / Customer *</label>
          <input type="text" name="to_location_or_customer" class="form-control" required placeholder="Vault B or Customer name">
        </div>
        <div class="col-md-4">
          <label class="form-label">Qty Out *</label>
          <input type="number" step="any" name="qty_out" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Unit Cost ($)</label>
          <input type="number" step="0.01" name="unit_cost" class="form-control" value="0">
        </div>
        <div class="col-md-4">
          <label class="form-label">Reference #</label>
          <input type="text" name="reference_number" class="form-control">
        </div>
        <div class="col-12">
          <label class="form-label">Notes</label>
          <textarea name="notes" class="form-control" rows="2"></textarea>
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-success">Save & Update Stock</button>
        <a href="{{ url_for('transfers_list') }}" class="btn btn-outline-secondary ms-2">Cancel</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}

{% extends "base.html" %}
{% block title %}Sales / Transfers – Farmer Direct{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Sales & Transfers</h2>
  <a href="{{ url_for('transfers_add') }}" class="btn btn-success"><i class="bi bi-plus-lg"></i> New Transaction</a>
</div>

<div class="table-card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>ID</th><th>Date</th><th>Type</th><th>From</th><th>To / Customer</th>
          <th>Product</th><th>Batch</th><th class="text-end">Qty Out</th>
          <th class="text-end">Value</th><th>By</th>
        </tr>
      </thead>
      <tbody>
        {% for t in records %}
        <tr>
          <td><code>{{ t.transaction_id }}</code></td>
          <td>{{ t.date }}</td>
          <td><span class="badge {% if t.type == 'Sale' %}bg-primary{% else %}bg-info{% endif %}">{{ t.type }}</span></td>
          <td>{{ t.from_location or '—' }}</td>
          <td>{{ t.to_location_or_customer or '—' }}</td>
          <td>{{ t.product_name or '—' }} <small class="text-muted">{{ t.sku }}</small></td>
          <td>{{ t.batch_lot or '—' }}</td>
          <td class="text-end">{{ t.qty_out }}</td>
          <td class="text-end">${{ "%.2f"|format(t.value_moved or 0) }}</td>
          <td>{{ t.handled_by or '—' }}</td>
        </tr>
        {% else %}
        <tr><td colspan="10" class="text-center text-muted py-4">No sales or transfers yet</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}

{% extends "base.html" %}
{% block title %}Users – Farmer Direct{% endblock %}
{% block content %}
<h2 class="mb-4">Users</h2>
<div class="table-card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr><th>Username</th><th>Full Name</th><th>Role</th><th>Active</th></tr>
      </thead>
      <tbody>
        {% for u in users %}
        <tr>
          <td><code>{{ u.username }}</code></td>
          <td>{{ u.full_name or '—' }}</td>
          <td><span class="badge {% if u.role == 'admin' %}bg-danger{% else %}bg-secondary{% endif %}">{{ u.role }}</span></td>
          <td>{% if u.active %}<span class="badge bg-success">Yes</span>{% else %}<span class="badge bg-secondary">No</span>{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
<p class="text-muted small mt-3">
  Default passwords are set for testing. Change them in production by editing the database or adding a password-change feature.
</p>
{% endblock %}

